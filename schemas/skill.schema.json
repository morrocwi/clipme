{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipme.local/schemas/skill.schema.json",
  "title": "clipme skill manifest",
  "type": "object",
  "required": ["id", "layer", "scopes", "task_scope", "activation"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "layer": {"enum": ["orchestration", "creator", "assurance", "delivery"]},
    "scopes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "task_scope": {"type": "object", "additionalProperties": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}},
    "requires": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "after_if_active": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "consumes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "produces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "gates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "assurance": {"type": "boolean"},
    "orchestration_only": {"type": "boolean"},
    "activation": {
      "type": "object",
      "required": ["default"],
      "properties": {
        "default": {"enum": ["required", "inline", "optional", "skip"]},
        "profiles": {"type": "object", "additionalProperties": {"enum": ["required", "inline", "optional", "skip"]}},
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {"enum": ["required", "inline", "optional", "skip"]},
              "when_any": {"type": "array", "items": {"type": "string"}},
              "when_all": {"type": "array", "items": {"type": "string"}},
              "force": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
