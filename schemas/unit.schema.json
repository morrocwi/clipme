{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipme.local/schemas/unit.schema.json",
  "title": "clipme unit graph",
  "type": "object",
  "required": ["units"],
  "properties": {
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "children"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["project", "act", "chapter", "sequence", "scene", "beat", "shot", "frame", "audio_event"]},
          "parent": {"type": ["string", "null"]},
          "children": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "refs": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
