{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipme.local/schemas/project.schema.json",
  "title": "clipme project",
  "type": "object",
  "required": [
    "id",
    "title",
    "profile",
    "language",
    "delivery",
    "intent"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "short-90s",
        "explainer",
        "longform",
        "film"
      ]
    },
    "language": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "intent": {
      "type": "object",
      "required": [
        "promise"
      ],
      "properties": {
        "promise": {
          "type": "string"
        },
        "core_question": {
          "type": "string"
        },
        "desired_viewer_change": {
          "type": "string"
        },
        "tone": {
          "type": "string"
        },
        "genre": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "duration": {
      "type": "object",
      "properties": {
        "target_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "delivery": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "video_codec": {
          "type": "string",
          "default": "h264"
        },
        "audio_codec": {
          "type": "string",
          "default": "aac"
        },
        "audio_sample_rate": {
          "type": "integer",
          "default": 48000
        },
        "channels": {
          "type": "integer",
          "default": 2
        }
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bible_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "skill_overrides": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "required",
          "inline",
          "optional",
          "skip"
        ]
      }
    }
  },
  "additionalProperties": true
}
