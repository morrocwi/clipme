#!/usr/bin/env bash
# Template only. scripts/bootstrap.sh writes the real, machine-specific
# scripts/env.sh (with your actual repo path baked in) — that generated file
# is gitignored and must never be committed. Copy this file manually only if
# you need env.sh without running bootstrap.sh, and edit REPO_ROOT.
#
#   source scripts/env.sh
REPO_ROOT="/path/to/clipme"
export PATH="$REPO_ROOT/bin:$PATH"
